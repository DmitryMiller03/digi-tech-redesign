// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

/// Catalog category — self-referencing so a category can have subcategories
/// (mirrors the source site's category -> subcategory -> product structure).
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  image       String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)

  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryToCategory")

  products Product[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String?
  description      String?
  images           String[] @default([])
  /// Free-form technical characteristics, e.g. {"Мощность": "5 кВт", "Габариты": "..."}
  specs            Json?
  /// What's included in the delivery (e.g. "Программное обеспечение на носителе",
  /// "Руководство по эксплуатации") — distinct from specs, shown as its own section.
  kitContents      String[] @default([])
  /// Price in RUB. Null means "цена по запросу" (price on request) — the
  /// source site mixes both models across the catalog, so this must stay
  /// optional rather than assuming every product has a listed price.
  price            Int?
  order            Int      @default(0)
  isPublished      Boolean  @default(true)

  /// Groups variants of the same underlying product (e.g. "Версия ПК" vs
  /// "Версия VR") so the product page can render them as a tab/selector.
  /// Products sharing a variantGroupId are siblings; variantLabel is what's
  /// shown on the tab for this particular row.
  variantGroupId String?
  variantLabel   String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  contactRequestItems ContactRequestItem[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([variantGroupId])
  @@map("products")
}

/// Static / semi-structured pages: About, Projects, Individual Development,
/// Professionalism program, plus any future one-off landing page.
model Page {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  /// Ordered list of content blocks (hero, richtext, gallery, cta, etc.)
  /// rendered by a block renderer on the frontend.
  content Json

  seoTitle       String?
  seoDescription String?

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model FaqItem {
  id          String  @id @default(cuid())
  question    String
  answer      String
  order       Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_items")
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

/// Every "Оставить заявку" form submission across the site lands here,
/// tagged with where it came from so the admin can see what's converting.
/// Cart checkouts land here too, with their line items in `items`.
model ContactRequest {
  id         String               @id @default(cuid())
  name       String
  company    String?
  phone      String
  email      String?
  message    String?
  sourcePage String
  status     ContactRequestStatus @default(NEW)

  items ContactRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("contact_requests")
}

/// A cart line item snapshotted onto a submitted request. productName is a
/// snapshot (kept even if the product is later edited/removed) so the
/// admin's request inbox always shows what was actually asked for.
model ContactRequestItem {
  id               String  @id @default(cuid())
  contactRequestId String
  contactRequest   ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  quantity         Int      @default(1)

  @@index([contactRequestId])
  @@map("contact_request_items")
}
